<div class="mb-4 flex items-center justify-between rounded-xl border bg-slate-50 px-4 py-3 text-sm"><span><strong><%= current_user.garments.in_laundry.count %></strong> in laundry · <strong><%= current_user.garments.clean.count %></strong> clean</span><%= link_to "Laundry & Wear History →", wear_history_path, class: "font-medium text-indigo-600" %></div>
<%= turbo_stream_from current_user, :wardrobe %>

<div class="space-y-6">
  <%= render "garments/status", user: current_user %>
  <%= render "garments/add_panel", garment: @garment %>
  <%= render "garments/inventory", garments: @garments, category: @category, user: current_user %>
</div>
