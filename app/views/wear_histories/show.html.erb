<div class="mx-auto max-w-5xl px-4 py-8 sm:px-6 lg:px-8">
  <div class="flex flex-wrap items-center justify-between gap-4 border-b border-slate-200 pb-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-slate-900">Laundry &amp; Wear History</h1>
      <p class="mt-1 text-sm text-slate-600">Track wears per garment and wash items in your hamper.</p>
    </div>
    <div class="flex items-center gap-3">
      <%= link_to "Back to Wardrobe", wardrobe_path, class: "rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700" %>
      <% if @in_laundry.any? %>
        <%= button_to "Wash All (#{@in_laundry.size})", wash_all_wardrobe_path, method: :post, class: "rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white" %>
      <% end %>
    </div>
  </div>
  <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-3">
    <div class="rounded-xl border border-slate-200 bg-white p-5"><p class="text-xs uppercase text-slate-500">In Laundry</p><p class="mt-2 text-3xl font-bold text-amber-600"><%= @in_laundry.size %></p></div>
    <div class="rounded-xl border border-slate-200 bg-white p-5"><p class="text-xs uppercase text-slate-500">Total Wears</p><p class="mt-2 text-3xl font-bold text-slate-900"><%= @garments.sum(&:wear_count) %></p></div>
    <div class="rounded-xl border border-slate-200 bg-white p-5"><p class="text-xs uppercase text-slate-500">Unworn</p><p class="mt-2 text-3xl font-bold text-indigo-600"><%= @unworn.size %></p></div>
  </div>
  <section class="mt-8">
    <h2 class="text-lg font-semibold text-slate-900">Laundry Basket (<%= @in_laundry.size %>)</h2>
    <% @in_laundry.each do |garment| %>
      <div id="<%= dom_id(garment) %>" class="mt-3 flex items-center justify-between rounded-xl border border-amber-200 bg-amber-50/40 p-4">
        <div><p class="font-medium"><%= garment.name %></p><p class="text-xs text-slate-500"><%= garment.wears_since_wash %>/<%= garment.effective_wash_threshold %> wears</p></div>
        <%= button_to "Mark Washed", laundry_garment_path(garment), method: :patch, class: "rounded-lg bg-emerald-600 px-3 py-1.5 text-xs font-semibold text-white" %>
      </div>
    <% end %>
  </section>
</div>
