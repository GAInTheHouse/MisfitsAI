<% content_for :title, "Outfit – #{@outfit.date.strftime('%A, %B %-d')}" %>

<div class="max-w-2xl mx-auto px-4 py-8">
  <%= link_to "← Back to outfits", outfits_path, class: "text-sm hover:underline mb-6 block", style: "color: var(--muted);" %>

  <h1 class="text-2xl font-semibold mb-1"><%= @outfit.date.strftime("%A, %B %-d") %></h1>
  <p class="text-sm mb-6" style="color: var(--muted);">
    <%= Planner::Prompts.event_label(@outfit.event_type) %>
    <% if @outfit.segment_label.present? %>
      · <%= @outfit.segment_label %>
    <% end %>
  </p>

  <div class="flex flex-wrap gap-3 mb-6">
    <% @outfit.garments_in_display_order.each do |g| %>
      <div class="w-20 h-20 rounded-xl border overflow-hidden" style="border-color: var(--line);">
        <%= render "garments/thumb", garment: g %>
      </div>
    <% end %>
  </div>

  <% if @outfit.explanation.present? %>
    <p class="text-sm mb-6" style="color: var(--muted);"><%= @outfit.explanation %></p>
  <% end %>

  <% if @preview_enabled && @avatar_ready %>
    <div class="border rounded-xl p-4" style="border-color: var(--line);">
      <h2 class="text-sm font-semibold mb-4">On Me</h2>
      <%= turbo_frame_tag dom_id(@outfit, :on_me) do %>
        <%= render "outfit_previews/preview", rec: @outfit %>
      <% end %>
    </div>
  <% end %>
</div>
