<% content_for :title, "Your Outfits" %>

<div class="max-w-3xl mx-auto px-4 py-8">
  <h1 class="text-2xl font-semibold mb-2">Your Outfits</h1>
  <% if @forecast.present? %>
    <p class="text-sm text-[var(--muted)] mb-6">
      Weather in <%= @forecast[:location] %>: <strong><%= @forecast[:temp_f] %>°F · <%= @forecast[:condition] %></strong>
    </p>
  <% end %>

  <% if @outfits.empty? %>
    <div class="text-center py-16 text-[var(--muted)]">
      <p class="mb-4">No outfits yet. Complete the calendar step to get recommendations.</p>
      <%= link_to "Go to Calendar", week_plan_path, class: "btn-primary px-5 py-2" %>
    </div>
  <% else %>
    <div class="space-y-4">
      <% @outfits.each do |rec| %>
        <%= render "outfits/day_card", rec: %>
      <% end %>
    </div>
  <% end %>
</div>
