<h1 class="text-2xl font-semibold mb-2">Add a photo</h1>
<p class="text-[var(--muted)] mb-6">Upload a selfie so we can show outfits on you. You can add one later from Profile.</p>

<% if flash[:alert].present? %>
  <p class="text-red-600 text-sm mb-4"><%= flash[:alert] %></p>
<% end %>

<% if Feature.enabled?(:avatar) %>
  <%= turbo_stream_from current_user, :avatar %>
  <div class="mb-8">
    <%= render "avatars/avatar_section", profile: profile %>
  </div>
<% end %>

<%= form_with url: onboarding_path, method: :patch, multipart: true, class: "w-full" do %>
  <% if Feature.enabled?(:avatar) %>
    <label for="onboarding_selfie_input" class="block text-sm font-medium text-[var(--muted)] mb-2">
      Choose a selfie to continue with upload
    </label>
    <input type="file" id="onboarding_selfie_input" name="selfie" accept="image/*" class="file-input mb-6" />
  <% end %>

  <div class="flex justify-between pt-4 gap-3 flex-wrap">
    <%= link_to "← Back", back_onboarding_path,
          data: { turbo_method: :post },
          class: "btn-ghost px-4 py-2" %>
    <div class="flex gap-2">
      <button type="submit" name="skip" value="1" class="btn-ghost px-4 py-2">Skip for now</button>
      <button type="submit" class="btn-primary px-6 py-2">Continue</button>
    </div>
  </div>
<% end %>