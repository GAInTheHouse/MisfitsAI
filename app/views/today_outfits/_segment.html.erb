<%# locals: outfit, time_zone (optional). Replaced by OutfitWearsController and Planner::ExplainOutfitJob. %>
<% time_zone ||= outfit.week_plan.user.time_zone %>
<% event_label = Planner::Prompts.event_label(outfit.event_type) %>
<li id="<%= dom_id(outfit, :timeline) %>" class="ml-5 timeline-segment">
  <span class="absolute -left-[7px] mt-1.5 h-3 w-3 rounded-full border-2 border-[var(--panel-strong)]"
        style="background: var(--ink);" aria-hidden="true"></span>

  <div class="rounded-xl border border-[var(--line)] p-4 bg-[var(--panel-strong)]">
    <div class="flex flex-wrap items-baseline justify-between gap-2 mb-1">
      <p class="text-sm font-medium">
        <% if outfit.starts_at %>
          <time datetime="<%= outfit.starts_at.iso8601 %>"><%= outfit.starts_at.in_time_zone(time_zone).strftime("%-l:%M %p") %></time><% if outfit.ends_at %>–<time datetime="<%= outfit.ends_at.iso8601 %>"><%= outfit.ends_at.in_time_zone(time_zone).strftime("%-l:%M %p") %></time><% end %>
        <% else %>
          All day
        <% end %>
      </p>
      <span class="pill text-xs"><%= event_label %></span>
    </div>
    <% if outfit.segment_label.present? %>
      <p class="text-sm text-[var(--muted)] mb-2"><%= outfit.segment_label %></p>
    <% end %>

    <% if outfit.change_reason.present? %>
      <p class="text-sm rounded-[var(--radius-md)] border border-[var(--line)] px-3 py-2 mb-3" role="note">
        <span class="font-medium">Outfit change.</span> <%= outfit.change_reason %>
      </p>
    <% end %>

    <% garments = outfit.garments_in_display_order %>
    <% if garments.any? %>
      <ul class="flex flex-wrap gap-3 mb-3">
        <% garments.each do |garment| %>
          <li class="flex flex-col items-center w-16 text-center">
            <div class="w-16 h-16 rounded-lg overflow-hidden border border-[var(--line)]">
              <%= render "garments/thumb", garment: %>
            </div>
            <span class="text-[11px] leading-tight mt-1 line-clamp-2"><%= garment.name %></span>
            <% if garment.in_laundry? %>
              <%# The engine only uses a piece from the laundry when nothing clean fits this slot (#9). %>
              <span class="text-[10px] mt-0.5" style="color: var(--error);">In laundry</span>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-sm text-[var(--muted)] mb-3">
        No item found. <%= link_to "Add more pieces to your wardrobe.", wardrobe_path, class: "underline" %>
      </p>
    <% end %>

    <% if outfit.explanation.present? %>
      <p class="text-xs text-[var(--muted)] mb-3"><%= outfit.explanation %></p>
    <% elsif outfit.explanation_status == "pending" %>
      <p class="text-xs text-[var(--muted)] animate-pulse mb-3">Generating explanation…</p>
    <% end %>

    <% if garments.any? %>
      <%= button_to outfit.worn? ? "Worn ✓ (undo)" : "I wore this", wear_outfit_path(outfit), method: :patch,
                    class: outfit.worn? ? "btn-ghost px-3 py-1.5 text-sm" : "btn-primary px-3 py-1.5 text-sm",
                    aria: { pressed: outfit.worn? } %>
    <% end %>
  </div>
</li>
