<% if flash.any? %>
  <div class="mb-4 space-y-2">
    <% flash.each do |type, message| %>
      <div class="rounded-[var(--radius-md)] px-4 py-3 text-sm border" style="background: var(--panel); border-color: var(--line); color: <%= type.to_s == 'alert' ? 'var(--error)' : 'var(--ink)' %>;">
        <%= message %>
      </div>
    <% end %>
  </div>
<% end %>
