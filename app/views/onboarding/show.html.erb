<% content_for :title, "Welcome to MisfitsAI" %>

<div class="min-h-screen flex flex-col">
  <%# Progress bar %>
  <div class="w-full bg-[var(--surface-2)] h-1">
    <div class="bg-[var(--accent)] h-1 transition-all duration-300"
      style="width: <%= ((@step.to_i + 1) * 20).clamp(0, 100) %>%"></div>
  </div>

  <div class="flex-1 flex flex-col items-center px-4 py-8 max-w-2xl mx-auto w-full">
    <%# Step counter %>
    <p class="text-xs text-[var(--muted)] mb-6 self-start">Step <%= @step + 1 %> of 5</p>

    <%= render "onboarding/step_#{@step}",
          profile: @profile,
          measurement: @measurement,
          catalog: @catalog,
          catalog_ids: @catalog_ids,
          week_plan: @week_plan %>
  </div>
</div>
