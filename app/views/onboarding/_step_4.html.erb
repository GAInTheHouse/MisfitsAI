<h1 class="text-2xl font-semibold mb-2">Your first week of outfits</h1>
<p class="text-[var(--muted)] mb-6">We're putting together 7 looks for you. Explanations stream in as they're ready.</p>

<%= turbo_stream_from current_user, :planner %>
<%= turbo_stream_from current_user, :wardrobe %>

<% if week_plan %>
  <div class="space-y-3 mb-8">
    <% week_plan.outfit_recommendations.order(:date).each do |rec| %>
      <div class="rounded-xl border border-[var(--line)] p-4 flex gap-4 items-start">
        <div class="text-sm font-medium w-20 shrink-0 text-[var(--muted)]">
          <%= rec.date.strftime("%A") %>
        </div>
        <div class="flex-1 min-w-0">
          <div class="flex flex-wrap gap-2 mb-2">
            <% rec.garments_in_display_order.each do |g| %>
              <%= turbo_frame_tag dom_id(g, :thumb), class: "w-10 h-10 rounded overflow-hidden border border-[var(--line)]" do %>
                <%= render "garments/thumb", garment: g %>
              <% end %>
            <% end %>
          </div>
          <% if rec.explanation.present? %>
            <p class="text-xs text-[var(--muted)]"><%= rec.explanation %></p>
          <% else %>
            <p class="text-xs text-[var(--muted)] animate-pulse">Generating explanation…</p>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="text-[var(--muted)] text-sm mb-8">Setting up your outfits…</div>
<% end %>

<%= form_with url: onboarding_path, method: :patch, class: "flex justify-end" do %>
  <button type="submit" class="btn-primary px-6 py-2">Enter My Wardrobe →</button>
<% end %>
