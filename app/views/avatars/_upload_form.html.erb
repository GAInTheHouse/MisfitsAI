<%= form_with url: avatar_path, method: :post, multipart: true,
      data: { turbo: false } do |f| %>
  <div class="flex flex-col gap-3">
    <label for="avatar_selfie_input" class="block text-sm font-medium text-[var(--muted)]">
      Upload a selfie — we'll generate an illustrated avatar
    </label>
    <label for="avatar_selfie_input" class="sr-only">Selfie</label>
    <input type="file" id="avatar_selfie_input" name="selfie" accept="image/*" class="file-input" />
    <% if flash[:avatar_error].present? %>
      <p class="text-red-600 text-sm"><%= flash[:avatar_error] %></p>
    <% end %>
    <button type="submit" class="btn-primary w-fit py-1.5 px-4 text-sm">Generate avatar</button>
  </div>
<% end %>
