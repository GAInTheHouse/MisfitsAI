<% today = Time.current.in_time_zone(current_user.time_zone).to_date %>
<% heading = @date == today ? "Today's outfits" : "#{@date.strftime('%A')}'s outfits" %>
<% content_for :title, heading %>
<%= turbo_stream_from current_user, :planner %>

<div class="max-w-3xl mx-auto px-4 py-8">
  <div class="flex items-center justify-between gap-3 mb-2">
    <h1 class="text-2xl font-semibold"><%= heading %></h1>
    <%= link_to "Back to calendar", week_plan_path, class: "text-sm underline underline-offset-4 shrink-0" %>
  </div>
  <p class="text-[var(--muted)] mb-6"><%= @date.strftime("%A, %B %-d") %></p>

  <nav class="flex items-center justify-between mb-8 text-sm" aria-label="Day">
    <% if @previous_date %>
      <%= link_to "← #{@previous_date.strftime('%A')}", today_outfits_path(date: @previous_date.iso8601),
                  class: "btn-ghost px-3 py-1.5" %>
    <% else %>
      <span></span>
    <% end %>
    <% if @next_date %>
      <%= link_to "#{@next_date.strftime('%A')} →", today_outfits_path(date: @next_date.iso8601),
                  class: "btn-ghost px-3 py-1.5" %>
    <% end %>
  </nav>

  <% if @outfits.empty? %>
    <div class="text-center py-16 text-[var(--muted)]">
      <p class="mb-4">Plan your week first.</p>
      <%= link_to "Go to Calendar", week_plan_path, class: "btn-primary px-5 py-2" %>
    </div>
  <% else %>
    <% if @outfits.size > 1 %>
      <p class="text-sm mb-4"><%= pluralize(@outfits.size, "outfit") %> today: change between your events.</p>
    <% end %>
    <ol class="relative border-l border-[var(--line)] ml-2 space-y-6" aria-label="Outfit timeline">
      <% @outfits.each do |outfit| %>
        <%= render "today_outfits/segment", outfit:, time_zone: current_user.time_zone %>
      <% end %>
    </ol>
  <% end %>
</div>
