<div id="avatar_section">
  <% if profile.avatar_status == "pending" %>
    <div class="flex items-center gap-3 text-[var(--muted)]">
      <%= render "shared/spinner" %>
      <span>Generating your avatar…</span>
    </div>

  <% elsif profile.avatar_status == "ready" && profile.avatar.attached? %>
    <div class="flex flex-col sm:flex-row gap-6 items-start">
      <%= image_tag rails_blob_path(profile.avatar, disposition: "inline"),
            alt: "Your avatar",
            class: "w-32 h-32 rounded-full object-cover",
            data: { avatar_image: true } %>
      <div>
        <p class="text-sm text-[var(--muted)] mb-3">Your illustrated avatar is ready.</p>
        <%= render "avatars/upload_form", profile: profile %>
      </div>
    </div>

  <% elsif profile.avatar_status == "failed" %>
    <div class="text-red-600 text-sm mb-3"><%= profile.avatar_error %></div>
    <%= render "avatars/upload_form", profile: profile %>

  <% else %>
    <%= render "avatars/upload_form", profile: profile %>
  <% end %>
</div>
