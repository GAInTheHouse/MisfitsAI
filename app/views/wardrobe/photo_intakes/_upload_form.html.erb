<%# locals: (error: nil) %>
<div id="photo_intake_form" class="space-y-4">
  <p class="text-sm text-[var(--muted)]">Upload an outfit photo and we'll pick out each garment for you to review.</p>
  <% if error %>
    <p role="alert" class="rounded-[var(--radius-md)] border px-4 py-3 text-sm" style="border-color: var(--error); color: var(--error);"><%= error %></p>
  <% end %>
  <%= form_with url: wardrobe_photo_intakes_path, multipart: true, class: "space-y-3" do |f| %>
    <div class="space-y-1">
      <%= f.label :photo, "Outfit photo", class: "text-sm font-medium" %>
      <%= f.file_field :photo, accept: "image/jpeg,image/png,image/webp,image/heic", required: true, class: "block text-sm" %>
      <p class="text-xs text-[var(--muted)]">JPEG, PNG, WebP or HEIC, up to 15 MB.</p>
    </div>
    <%= f.submit "Analyze photo", class: "btn-primary" %>
  <% end %>
</div>
