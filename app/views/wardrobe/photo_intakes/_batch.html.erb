<%# locals: (batch:) %>
<%# Replaced as a whole by Wardrobe::ExtractGarmentsJob when analysis finishes (design doc 2.4). %>
<div id="<%= dom_id(batch) %>" class="space-y-4">
  <% case batch.status %>
  <% when "ready" %>
    <%= render "wardrobe/photo_intakes/review", batch: batch %>
  <% when "failed" %>
    <div class="space-y-3">
      <p role="alert" class="rounded-[var(--radius-md)] border px-4 py-3 text-sm" style="border-color: var(--error); color: var(--error);"><%= batch.error %></p>
      <%= button_to "Try again", wardrobe_intake_batch_path(batch), method: :delete, class: "btn-primary" %>
    </div>
  <% else %>
    <div class="flex flex-col items-center gap-3 rounded-[var(--radius-lg)] border p-8 text-center" style="border-color: var(--line); background: var(--panel);">
      <span class="spinner" aria-hidden="true"></span>
      <p class="text-sm font-medium" role="status" aria-live="polite"
         data-controller="shared--rotating-text"
         data-shared--rotating-text-messages-value="<%= Options.fetch(:photo_scanning_messages).to_json %>">
        <%= Options.fetch(:photo_scanning_messages).first %>
      </p>
      <p class="text-xs text-[var(--muted)]">This usually takes a few seconds.</p>
    </div>
  <% end %>
</div>
