<div class="card">
  <h2 class="font-semibold mb-4">Sizes</h2>
  <%= form_with url: profile_path, method: :patch,
        data: { controller: "shared--dirty-form", turbo_frame: "profile_sizes" } do |f| %>
    <%= hidden_field_tag :section, "sizes" %>

    <div class="mb-4">
      <label class="block text-sm font-medium mb-2">Top size</label>
      <div class="flex flex-wrap gap-2">
        <% UserProfile::SIZES.each do |s| %>
          <label class="pill cursor-pointer">
            <input type="radio" name="user_profile[top_size]" id="top_size_<%= s.downcase %>"
              value="<%= s %>" class="sr-only"
              <%= "checked" if profile.top_size == s %>
              data-action="change->shared--dirty-form#changed" />
            <span><%= s %></span>
          </label>
        <% end %>
      </div>
    </div>

    <div class="mb-4">
      <label class="block text-sm font-medium mb-2">Bottom size</label>
      <div class="flex flex-wrap gap-2">
        <% UserProfile::SIZES.each do |s| %>
          <label class="pill cursor-pointer">
            <input type="radio" name="user_profile[bottom_size]" id="bottom_size_<%= s.downcase %>"
              value="<%= s %>" class="sr-only"
              <%= "checked" if profile.bottom_size == s %>
              data-action="change->shared--dirty-form#changed" />
            <span><%= s %></span>
          </label>
        <% end %>
      </div>
    </div>

    <div class="mb-4">
      <label class="block text-sm font-medium mb-1" for="shoe_size">Shoe size</label>
      <input type="text" name="user_profile[shoe_size]" id="shoe_size"
        value="<%= profile.shoe_size %>" maxlength="10"
        class="input w-32"
        data-action="input->shared--dirty-form#changed" />
    </div>

    <div data-dirty-form-target="bar" hidden class="flex gap-2 pt-2">
      <button type="submit" class="btn-primary py-1.5 px-4 text-sm">Save</button>
      <button type="button" class="btn-ghost py-1.5 px-4 text-sm"
        data-action="click->shared--dirty-form#discard">Discard</button>
    </div>
  <% end %>
</div>
