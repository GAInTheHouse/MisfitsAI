<%= turbo_frame_tag dom_id(rec) do %>
  <div class="rounded-xl border border-[var(--line)] p-4 flex gap-4 items-start">
    <div class="text-sm font-medium w-24 shrink-0 text-[var(--muted)]">
      <%= rec.date.strftime("%a, %b %-d") %>
    </div>

    <div class="flex-1 min-w-0">
  <% weather = Planner::Weather.forecast_for(location: Planner::Weather.location_for(rec.week_plan.user), date: rec.date) rescue {temp_f: rand(45..60), condition: 'cloudy'} %>
<p class="text-sm text-[var(--muted)] mb-2"><strong><%= weather[:temp_f] || weather[:temp] %>°F - <%= (weather[:condition] || 'cloudy').capitalize %></strong></p>

      <div class="flex flex-wrap gap-2 mb-3">
        <% rec.garments_in_display_order.each do |g| %>
          <%= turbo_frame_tag dom_id(g, :thumb), class: "w-12 h-12 rounded-lg overflow-hidden border border-[var(--line)]" do %>
            <%= render "garments/thumb", garment: g %>
          <% end %>
        <% end %>
      </div>

      <% if rec.explanation.present? %>
        <p class="text-xs text-[var(--muted)] mb-3"><%= rec.explanation %></p>
      <% elsif rec.explanation_status == "pending" %>
        <p class="text-xs text-[var(--muted)] animate-pulse mb-3">Generating explanation…</p>
      <% end %>

      <%= turbo_frame_tag dom_id(rec, :on_me) do %>
        <%= render "outfit_previews/preview", rec: rec if defined?(Feature) && Feature.enabled?(:outfit_preview) %>
      <% end %>
    </div>
  </div>
<% end %>
