<%= render layout: "devise/shared/card", locals: { title: "Forgot password?" } do %>
  <p class="text-sm text-[var(--muted)]">Enter your email and we'll send reset instructions.</p>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "space-y-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="space-y-1">
      <%= f.label :email, class: "text-sm font-medium" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true, class: "input" %>
    </div>

    <%= f.submit "Send reset instructions", class: "btn-primary w-full" %>
  <% end %>

  <%= render "devise/shared/links" %>
<% end %>
