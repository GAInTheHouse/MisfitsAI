<div class="space-y-3 pt-2 text-sm text-center border-t" style="border-color: var(--line);">
  <%- if controller_name != "sessions" %>
    <%= link_to "Log in", new_session_path(resource_name), class: "text-[var(--ink)] underline underline-offset-2" %>
  <% end %>

  <%- if devise_mapping.registerable? && controller_name != "registrations" %>
    <%= link_to "Sign up", new_registration_path(resource_name), class: "text-[var(--ink)] underline underline-offset-2" %>
  <% end %>

  <%- if devise_mapping.recoverable? && controller_name != "passwords" && controller_name != "registrations" %>
    <%= link_to "Forgot your password?", new_password_path(resource_name), class: "block text-[var(--muted)] underline underline-offset-2" %>
  <% end %>

  <%- if devise_mapping.omniauthable? %>
    <div class="text-xs text-[var(--muted)]">or continue with</div>
    <% resource_class.omniauth_providers.each do |provider| %>
      <%= button_to "Continue with Google",
                    omniauth_authorize_path(resource_name, provider),
                    method: :post,
                    data: { turbo: false },
                    class: "btn-ghost w-full" %>
    <% end %>
  <% end %>
</div>
