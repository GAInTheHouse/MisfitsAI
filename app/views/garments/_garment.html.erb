<%# locals: (garment:) %>
<%# Rendered on the page, in Turbo Stream responses and in broadcasts, so it must not use current_user. %>
<article id="<%= dom_id(garment) %>" class="garment-card flex flex-col overflow-hidden rounded-[var(--radius-lg)] border"
         style="background: var(--panel-strong); border-color: var(--line);" data-name="<%= garment.name %>" aria-label="<%= garment.name %>">
  <div class="relative aspect-square" style="background: var(--panel);">
    <%= image_tag garment_image_source(garment, :card), alt: garment.name, loading: "lazy",
                  class: "h-full w-full object-contain", data: { image_source: (garment.image.attached? ? "upload" : "placeholder") } %>
    <% if garment.image_status == "pending" %>
      <div class="absolute inset-x-2 bottom-2 rounded-full px-3 py-1" style="background: var(--panel-strong);">
        <%= render "shared/spinner", message: "Creating image…" %>
      </div>
    <% end %>
  </div>
  <div class="flex flex-1 flex-col gap-2 p-3">
    <h3 class="text-sm font-medium leading-snug"><%= garment.name %></h3>
    <div class="flex flex-wrap gap-1">
      <span class="badge"><%= garment_category_label(garment.category) %></span>
      <% if garment.formality %>
        <span class="badge"><%= garment_option_label(:formality, garment.formality) %></span>
      <% end %>
      <% if garment.seasonality %>
        <span class="badge"><%= garment_option_label(:seasonality, garment.seasonality) %></span>
      <% end %>
      <% if garment.hidden_from_recommendations %>
        <span class="badge" style="color: var(--ink); border-color: var(--line-strong);">Hidden from outfits</span>
      <% end %>
    </div>
    <div class="mt-auto flex flex-wrap gap-2 pt-1">
      <% hidden = garment.hidden_from_recommendations %>
      <%= button_to (hidden ? "Show in outfits" : "Hide from outfits"), hide_garment_path(garment),
                    method: :patch, params: { hidden: !hidden }, class: "btn-ghost px-3 py-1 text-xs" %>
      <%= button_to "Delete", garment_path(garment), method: :delete, class: "btn-ghost px-3 py-1 text-xs",
                    form: { data: { turbo_confirm: "Remove this item from your wardrobe?" } } %>
    </div>
  </div>
</article>
