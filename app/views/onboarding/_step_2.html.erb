<h1 class="text-2xl font-semibold mb-2">What's already in your closet?</h1>
<p class="text-[var(--muted)] mb-6">Pick the items you own. You can add more from your wardrobe later.</p>

<%= form_with url: onboarding_path, method: :patch, class: "w-full" do |f| %>
  <% catalog.each do |category, items| %>
    <div class="mb-6">
      <p class="text-sm font-semibold uppercase tracking-wide text-[var(--muted)] mb-3">
        <%= category.capitalize %>s
      </p>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
        <% items.each do |item| %>
          <% owned = catalog_ids.include?(item["id"]) %>
          <label class="selection-card relative flex items-center gap-2 rounded-xl border p-3 cursor-pointer transition">
            <input type="checkbox" name="catalog_ids[]" value="<%= item["id"] %>"
              class="sr-only" <%= "checked" if owned %> />
            <span class="text-sm font-medium"><%= item["name"] %></span>
          </label>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="flex justify-between pt-4">
    <%= button_to "← Back", back_onboarding_path, method: :post, class: "btn-ghost px-4 py-2" %>
    <button type="submit" class="btn-primary px-6 py-2">Continue</button>
  </div>
<% end %>