<h1 class="text-2xl font-semibold mb-2">Your style</h1>
<p class="text-[var(--muted)] mb-6">Help us understand your aesthetic so we can tailor your outfits.</p>

<%= form_with url: onboarding_path, method: :patch, class: "w-full space-y-8" do |f| %>
  <div>
    <p class="text-sm font-medium mb-3">Your aesthetic</p>
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
      <% Options.fetch(:aesthetics).each do |aesthetic| %>
        <% selected = Array(profile.aesthetics).include?(aesthetic["key"]) %>
        <label class="relative flex flex-col gap-1 rounded-xl border p-3 cursor-pointer transition
          <%= selected ? 'border-[var(--accent)] bg-[var(--surface-2)]' : 'border-[var(--line)]' %>">
          <input type="checkbox" name="user_profile[aesthetics][]" value="<%= aesthetic["key"] %>"
            class="sr-only" <%= "checked" if selected %> />
          <span class="font-medium text-sm"><%= aesthetic["label"] %></span>
          <span class="text-xs text-[var(--muted)]"><%= aesthetic["description"] %></span>
        </label>
      <% end %>
    </div>
  </div>

  <div>
    <p class="text-sm font-medium mb-3">Color palette</p>
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
      <% Options.fetch(:style_color_tones).each do |tone| %>
        <% selected = Array(profile.style_color_tones).include?(tone["key"]) %>
        <label class="relative flex flex-col gap-1 rounded-xl border p-3 cursor-pointer transition
          <%= selected ? 'border-[var(--accent)] bg-[var(--surface-2)]' : 'border-[var(--line)]' %>">
          <input type="checkbox" name="user_profile[style_color_tones][]" value="<%= tone["key"] %>"
            class="sr-only" <%= "checked" if selected %> />
          <span class="font-medium text-sm"><%= tone["label"] %></span>
          <span class="text-xs text-[var(--muted)]"><%= tone["description"] %></span>
        </label>
      <% end %>
    </div>
  </div>

  <div data-controller="shared--filter-list">
    <p class="text-sm font-medium mb-3">Favourite brands</p>
    <div class="flex flex-wrap gap-2 mb-3">
      <% Options.fetch(:featured_brands).each do |brand| %>
        <% selected = Array(profile.brands).include?(brand) %>
        <label class="pill cursor-pointer <%= 'ring-2 ring-[var(--accent)]' if selected %>">
          <input type="checkbox" name="user_profile[brands][]" value="<%= brand %>"
            class="sr-only" <%= "checked" if selected %> />
          <span><%= brand %></span>
        </label>
      <% end %>
    </div>
    <details class="text-sm">
      <summary class="cursor-pointer text-[var(--muted)] list-none">+ Show all brands</summary>
      <div class="mt-3 space-y-2">
        <input type="text" placeholder="Filter brands…" class="input w-full mb-2"
          data-shared--filter-list-target="input" data-action="input->shared--filter-list#filter" />
        <div class="flex flex-wrap gap-2" data-shared--filter-list-target="list">
          <% Options.fetch(:search_brands).each do |brand| %>
            <% next if Options.fetch(:featured_brands).include?(brand) %>
            <% selected = Array(profile.brands).include?(brand) %>
            <label class="pill cursor-pointer <%= 'ring-2 ring-[var(--accent)]' if selected %>"
              data-shared--filter-list-item="<%= brand.downcase %>">
              <input type="checkbox" name="user_profile[brands][]" value="<%= brand %>"
                class="sr-only" <%= "checked" if selected %> />
              <span><%= brand %></span>
            </label>
          <% end %>
        </div>
      </div>
    </details>
  </div>

  <div class="flex justify-between pt-2">
    <%= button_to "← Back", back_onboarding_path, method: :post, class: "btn-ghost px-4 py-2" %>
    <button type="submit" class="btn-primary px-6 py-2">Next →</button>
  </div>
<% end %>
